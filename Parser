class Parser {
    private final List<Token> tokens;
    private int pos;

    Parser(List<Token> tokens) {
        this.tokens = tokens;
        this.pos    = 0;
    }

    private Token current()               { return tokens.get(pos); }
    private boolean check(Token.Type t)   { return current().type == t; }

    private Token consume(Token.Type expected) {
        Token t = current();
        if (t.type != expected)
            throw new RuntimeException(
                "Parse Error: Expected " + expected + " but found '" + t.value + "'");
        pos++;
        return t;
    }

    // E -> T E'
    ASTNode parseExpression() {
        return parseExpressionPrime(parseTerm());
    }

    // E' -> + T E' | - T E' | epsilon
    private ASTNode parseExpressionPrime(ASTNode left) {
        if (check(Token.Type.PLUS) || check(Token.Type.MINUS)) {
            Token op = current(); pos++;
            ASTNode node = new ASTNode(op.value);
            node.left  = left;
            node.right = parseTerm();
            return parseExpressionPrime(node);
        }
        return left;
    }

    // T -> F T'
    private ASTNode parseTerm() {
        return parseTermPrime(parseFactor());
    }

    // T' -> * F T' | / F T' | epsilon
    private ASTNode parseTermPrime(ASTNode left) {
        if (check(Token.Type.MULTIPLY) || check(Token.Type.DIVIDE)) {
            Token op = current(); pos++;
            ASTNode node = new ASTNode(op.value);
            node.left  = left;
            node.right = parseFactor();
            return parseTermPrime(node);
        }
        return left;
    }

    // F -> (E) | -F | number
    private ASTNode parseFactor() {
        if (check(Token.Type.MINUS)) {               // unary minus
            pos++;
            ASTNode node = new ASTNode("-");
            node.isUnary = true;
            node.left    = parseFactor();
            return node;
        }
        if (check(Token.Type.LPAREN)) {              // parenthesised sub-expression
            pos++;
            ASTNode node = parseExpression();
            consume(Token.Type.RPAREN);
            return node;
        }
        if (check(Token.Type.NUMBER)) {              // number literal
            Token t = current(); pos++;
            return new ASTNode(t.value);
        }
        throw new RuntimeException("Parse Error: Unexpected token '" + current().value + "'");
    }

    /** Parse the full input and verify nothing is left over. */
    ASTNode parse() {
        ASTNode root = parseExpression();
        if (!check(Token.Type.EOF))
            throw new RuntimeException(
                "Parse Error: Unexpected token '" + current().value + "' after expression");
        return root;
    }
}


