class ASTNode {
    final String value;       // operator (+, -, *, /) or number literal
    ASTNode left;
    ASTNode right;
    boolean isUnary;          // true for unary minus

    ASTNode(String value) {
        this.value   = value;
        this.left    = null;
        this.right   = null;
        this.isUnary = false;
    }

    /** Compact inline form, e.g. ((3 + 2) * 5) */
    String toInlineString() {
        if (left == null && right == null) return value;
        if (isUnary) return "(-" + left.toInlineString() + ")";
        return "(" + left.toInlineString() + " " + value + " " + right.toInlineString() + ")";
    }
}
